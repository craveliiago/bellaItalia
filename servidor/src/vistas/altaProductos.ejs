<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta de Productos</title>
    <link rel="stylesheet" href="../CSS/altas.css">
    <!-- <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> -->
</head>
<body>

    <header class="header">
       <a href="/"><img src="../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>
    <h1>ingresar producto</h1>
    <form action="/productos/nuevo" method="post">
        <input type="number" name="idhtml" placeholder="id producto">
        <input type="text" name="nomhtml" placeholder="nombre">
        <input type="text" name="deshtml" placeholder="descripcion">
        <input type="number" name="prehtml" placeholder="precio">
        <input type="text" name="cathtml" placeholder="id de la categoria">
        <input type="submit" id="enviar" value="enviar">
    </form>

    <h1>tabla de categorias</h1>
    <table border="1">
        <thead>
            <th>id categoria</th>
            <th>nombre</th>
        </thead>
        <tbody>
            <%if(registros2.length>0){
                registros2.forEach(cat=>{%>
                    <%if (cat.idcategoria>0){%>
                    <tr>
                        <th><%=cat.idcategoria%></th>
                        <th><%=cat.nombre%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>

</body>
</html>