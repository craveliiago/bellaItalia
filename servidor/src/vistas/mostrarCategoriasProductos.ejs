<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar productos de la categoria</title>
    <link rel="stylesheet" href="../../../CSS/mostrar.css">
</head>
<body>
    <header class="header">
       <a href="/"><img src="../../../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>
    <article>
        <h1>productos de la categoria</h1>
        <table border="1">
            <thead>
                <th>id producto</th>
                <th>nombre</th>
                <th>descripcion</th>
                <th>precio</th>
                <th>categoria</th>
            </thead>
            <tbody>
                <%if(registrosProductosId.length>0){
                    registrosProductosId.forEach(pro=>{%>
                        <%if (pro.idproducto>0){%>
                        <tr>
                            <th><%=pro.idproducto%></th>
                            <th><%=pro.nombre%></th>
                            <th><%=pro.descripcion%></th>
                            <th><%=pro.precio%></th>
                            <th><%=pro.nombreCat%></th>
                        </tr>
                        <%}%>
                    <%})
                } else{%>
                    <tr>
                        <p>No hay registros</p>
                    </tr>
                <%}%>
            </tbody>
        </table>
    </article>
</body>
</html>