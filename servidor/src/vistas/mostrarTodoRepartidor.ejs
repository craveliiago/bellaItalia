<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar repartidores</title>
    <link rel="stylesheet" href="../CSS/mostrar.css">
</head>
<body>
    <header class="header">
       <a href="/"><img src="../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>

    <h1>Consulta de Repartidores</h1>
    <!-- <form action="/repartidores/consulta/idbuscar" method="get"> -->
        <form onsubmit="buscarid(event)">
        <input type="number" name="idbuscar"  placeholder="ID repartidor" id="idbuscar">
        <input type="submit" value="buscar" id="enviar">

    </form>

<script>
    function buscarid(event) {
        event.preventDefault();
        let idbuscar = document.getElementById('idbuscar').value;
        window.location.href = `/repartidor/consulta/${idbuscar}`;
        document.getElementById('idbuscar').value = "";
        
    }

    
</script>


    <article>
    <h1>mostrar todo repartidor</h1>
    <table border="1">
        <thead>
            <th>idrepartidor</th>
            <th>nombre</th>
            <th>apellidos</th>
            <th>telefono</th>
            <th>vehiculo</th>
        </thead>
        <tbody>
            <%if(registros.length>0){
                registros.forEach(rep=>{%>
                    <%if (rep.idrepartidor>0){%>
                    <tr>
                        <th><%=rep.idrepartidor%></th>
                        <th><%=rep.nombre%></th>
                        <th><%=rep.apellidos%></th>
                        <th><%=rep.telefono%></th>
                        <th><%=rep.vehiculo%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>
    </article>
</body>
</html>