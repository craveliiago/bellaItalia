<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar detalles del pedido</title>
    <link rel="stylesheet" href="../../../CSS/mostrar.css">
</head>
<body>
    <header class="header">
       <a href="/"><img src="../../../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>
    <article>
    <h1>mostrar detalles del pedido</h1>
    <table border="1">
        <thead>
            <th>iddetalle</th>
            <th>cantidad</th>
            <th>subtotal</th>
            <th>producto_idproducto</th>
            <th>pedidos_idpedido</th>
        </thead>
        <tbody>
            <%if(registrosDetallesId.length>0){
                registrosDetallesId.forEach(det=>{%>
                    <%if (det.iddetalle>0){%>
                    <tr>
                        <th><%=det.iddetalle%></th>
                        <th><%=det.cantidad%></th>
                        <th><%=det.subtotal%></th>
                        <th><%=det.producto_idproducto%></th>
                        <th><%=det.pedidos_idpedido%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>
    </article>
</body>
</html>