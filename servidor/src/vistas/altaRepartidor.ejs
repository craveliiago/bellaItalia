<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta de Repartidores</title>
    <link rel="stylesheet" href="../CSS/altas.css">
</head>
<body>
    <header class="header">
       <a href="/"><img src="../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>
    <h1>ingresar repartidor</h1>
    <form action="/repartidor/nuevo" method="post">
        <input type="number" name="idhtml" placeholder="id repartidor">
        <input type="text" name="nomhtml" placeholder="nombre">
        <input type="text" name="apehtml" placeholder="apellidos">
        <input type="tel" name="telhtml" placeholder="teléfono">

        <select name="vehhtml" placeholder="vehiculo">
            <option value="Auto">Auto</option>
            <option value="Moto">Moto</option>
            <option value="Bicicleta">Bicicleta</option>
        </select>

        <input type="submit" id="enviar" value="enviar">
    </form>
</body>
</html>