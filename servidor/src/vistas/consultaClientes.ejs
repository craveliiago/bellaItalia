<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BellaItalia - Consulta Clientes</title>
    <link rel="stylesheet" href="../../CSS/altas.css">
</head>
<body>
    
    <header class="header">
       <a href="/"><img src="../../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>

    <article>
        
    <h1>mostrar la consulta del cliente</h1>
    <table border="1">
        <thead>
            <th>id cliente</th>
            <th>nombre</th>
            <th>apellidos</th>
            <th>direccion</th>
            <th>telefono</th>
            <th>correo</th>
        </thead>
        <tbody>
            <%if(registro.length>0){
                registro.forEach(cli=>{%>
                    <%if (cli.idcliente>0){%>
                    <tr>
                        <th><a href="/clientes/todos/pedidos/<%=cli.idcliente%>" id="numero"><%=cli.idcliente%></a></th>
                        <th><%=cli.nombre%></th>
                        <th><%=cli.apellidos%></th>
                        <th><%=cli.direccion%></th>
                        <th><%=cli.telefono%></th>
                        <th><%=cli.correo%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>
</article>
</body>
</html>