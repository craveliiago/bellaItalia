<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta de Pedidos</title>
    <link rel="stylesheet" href="../CSS/altas.css">
</head>
<body>
    <header class="header">
       <a href="/"><img src="../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>
    <h1>ingresar pedido</h1>
    <form action="/pedidos/nuevo" method="post">
        <input type="number" name="idhtml" placeholder="id pedido">
        <input type="date" name="fpedhtml" placeholder="fecha pedido">
        <input type="time" name="hpedhtml" placeholder="hora pedido">

        <select name="tiphtml" placeholder="tipo">
            <option value="A domicilio">A domicilio</option>
            <option value="Para llevar">Para llevar</option>
            <option value="En el local">En el local</option>
        </select>

        <select name="esthtml" placeholder="estado">
            <option value="En preparacion">En preparacion</option>
            <option value="Listo">Listo</option>
            <option value="En camino">En camino</option>
            <option value="Entregado">Entregado</option>
            <option value="Cancelado">Cancelado</option>

        <input type="number" name="tothtml" placeholder="total">
        <input type="date" name="fenthtml" placeholder="fecha entrega">
        <input type="time" name="henthtml" placeholder="hora entrega">
        <input type="number" name="rephtml" placeholder="repartidor">
        <input type="number" name="clihtml" placeholder="cliente">
        <input type="submit" id="enviar" value="enviar">
    </form>

    <h1>tabla de clientes</h1>
    <table border="1">
        <thead>
            <th>id cliente</th>
            <th>nombre</th>
            <th>apellidos</th>
        </thead>
        <tbody>
            <%if(registros.length>0){
                registros.forEach(cli=>{%>
                    <%if (cli.idcliente>0){%>
                    <tr>
                        <th><%=cli.idcliente%></th>
                        <th><%=cli.nombre%></th>
                        <th><%=cli.apellidos%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>

    <h1>tabla de repartidores</h1>
    <table border="1">
        <thead>
            <th>id repartidor</th>
            <th>nombre</th>
            <th>vehiculo</th>
        </thead>
        <tbody>
            <%if(registros2.length>0){
                registros2.forEach(rep=>{%>
                    <%if (rep.idrepartidor>0){%>
                    <tr>
                        <th><%=rep.idrepartidor%></th>
                        <th><%=rep.nombre%></th>
                        <th><%=rep.vehiculo%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>
</body>
</html>