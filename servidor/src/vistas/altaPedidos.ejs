<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>ingresar pedido</h1>
    <form action="/pedidos/nuevo" method="post">
        <input type="number" name="idhtml" placeholder="id">
        <input type="date" name="fpedhtml" placeholder="fecha pedido">
        <input type="time" name="hpedhtml" placeholder="hora pedido">
        <input type="text" name="tiphtml" placeholder="tipo">
        <input type="text" name="esthtml" placeholder="estado">
        <input type="number" name="tothtml" placeholder="total">
        <input type="date" name="fenthtml" placeholder="fecha entrega">
        <input type="time" name="henthtml" placeholder="hora entrega">
        <input type="number" name="rephtml" placeholder="repartidor">
        <input type="number" name="clihtml" placeholder="cliente">
        <h1>completar datos del pedido</h1>
        <input type="number" name="detallehtml" placeholder="id">
        <input type="number" name="canthtml" placeholder="cantidad">
        <input type="number" name="subhtml" placeholder="subtotal">
        <input type="number" name="prodhtml" placeholder="producto">
        <input type="submit" value="enviar">
    </form>
</body>
</html>