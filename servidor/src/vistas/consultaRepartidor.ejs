<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>consulta repartidores</title>
    <link rel="stylesheet" href="../../CSS/altas.css">
</head>
<body>
    
    <header class="header">
       <a href="/"><img src="../../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>

    <article>
        
    <h1>mostrar la consulta del repartidor</h1>
    <table border="1">
        <thead>
            <th>id repartidor</th>
            <th>nombre</th>
            <th>apellidos</th>
            <th>telefono</th>
            <th>vehiculo</th>
        </thead>
        <tbody>
            <%if(registro.length>0){
                registro.forEach(rep=>{%>
                    <%if (rep.idrepartidor>0){%>
                    <tr>
                        <th><a href="/repartidor/todos/pedidos/<%=rep.idrepartidor%>" id="numero"><%=rep.idrepartidor%></a></th>
                        <th><%=rep.nombre%></th>
                        <th><%=rep.apellidos%></th>
                        <th><%=rep.telefono%></th>
                        <th><%=rep.vehiculo%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>
</article>
</body>
</html>