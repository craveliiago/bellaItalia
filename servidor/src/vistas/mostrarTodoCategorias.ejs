<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BellaItalia - Mostrar Categorías</title>
    <link rel="stylesheet" href="../CSS/mostrar.css">
</head>
<body>
    <header class="header">
       <a href="/"><img src="../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>


    <h1>Consulta de Categorias</h1>
    <!-- <form action="/categorias/consulta/idbuscar" method="get"> -->
        <form onsubmit="buscarid(event)">
        <input type="number" name="idbuscar"  placeholder="ID categoria" id="idbuscar">
        <input type="submit" value="buscar" id="enviar">

    </form>

<script>
    function buscarid(event) {
        event.preventDefault();
        let idbuscar = document.getElementById('idbuscar').value;
        window.location.href = `/categorias/consulta/${idbuscar}`;
        document.getElementById('idbuscar').value = "";
        
    }

    
</script>


    <article>
    <h1>mostrar todo categoria</h1>
    <table border="1">
        <thead>
            <th>id categoria</th>
            <th>nombre</th>
        </thead>
        <tbody>
            <%if(registros.length>0){
                registros.forEach(cat=>{%>
                    <%if (cat.idcategoria>0){%>
                    <tr>
                        <th><a href="todos/productos/<%=cat.idcategoria%>" id="numero"><%=cat.idcategoria%></a></th>
                        <th><%=cat.nombre%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>
    </article>
</body>
</html>