<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mostrar categorías</title>
    <link rel="stylesheet" href="../CSS/mostrar.css">
</head>
<body>
    <header class="header">
       <a href="/"><img src="../IMG/bellaitalia-logo3.png" alt="logo" id="logo"></a>
    </header>
    <article>
    <h1>mostrar todo categoria</h1>
    <table border="1">
        <thead>
            <th>idcategoria</th>
            <th>nombre</th>
        </thead>
        <tbody>
            <%if(registros.length>0){
                registros.forEach(cat=>{%>
                    <%if (cat.idcategoria>0){%>
                    <tr>
                        <th><a href="todos/categorias/<%=cat.idcategoroia>"><%=cat.idcategoria%></a></th>
                        <th><%=cat.nombre%></th>
                    </tr>
                    <%}%>
                <%})
            } else{%>
                <tr>
                    <p>No hay registros</p>
                </tr>
            <%}%>
        </tbody>
    </table>
    </article>
</body>
</html>